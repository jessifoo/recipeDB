/**
 * <%= className %> Router - tRPC API endpoints
 * Generated by: nx g feature <%= fileName %>
 * 
 * Thin transport layer - validates input and delegates to service
 */

import { z } from 'zod';
import { TRPCError } from '@trpc/server';
import { router, publicProcedure } from '@/server/api/trpc';
import { <%= className %>Service } from '@/core/services/<%= fileName %>.service';
import type { 
  Create<%= className %>DTO,
  Update<%= className %>DTO 
} from '@/core/ports/<%= fileName %>.repository.port';

// Choose your adapter (swap easily)
import { Prisma<%= className %>Repository } from '../db/prisma-<%= fileName %>.adapter';
// import { Mongo<%= className %>Repository } from '../db/mongo-<%= fileName %>.adapter';
// import { InMemory<%= className %>Repository } from '../db/inmemory-<%= fileName %>.adapter';

import { ConsoleLogger } from '../logger/console.adapter';
import { InMemoryCache } from '../cache/in-memory.adapter';
import { InMemoryEventBus } from '../events/in-memory.adapter';
import { db } from '@/lib/db';

/**
 * Zod validation schemas
 */
const create<%= className %>Schema = z.object({
  <% fields.forEach(function(field) { %>
  <%= field.name %>: <%= field.zodType %><% if (!field.isOptional) { %><% } %>,
  <% }); %>
});

const update<%= className %>Schema = z.object({
  <% fields.forEach(function(field) { %>
  <%= field.name %>: <%= field.zodType %>.optional(),
  <% }); %>
});

const filter<%= className %>Schema = z.object({
  search: z.string().optional(),
}).optional();

/**
 * <%= className %> tRPC Router
 */
export const <%= propertyName %>Router = router({
  /**
   * Get <%= propertyName %> by ID
   */
  getById: publicProcedure
    .input(z.string())
    .query(async ({ input, ctx }) => {
      const service = create<%= className %>Service(ctx.correlationId);
      try {
        return await service.getById(input);
      } catch (error) {
        throw toTRPCError(error);
      }
    }),

  /**
   * List <%= propertyName %>s with optional filter
   */
  list: publicProcedure
    .input(filter<%= className %>Schema)
    .query(async ({ input, ctx }) => {
      const service = create<%= className %>Service(ctx.correlationId);
      try {
        return await service.list(input);
      } catch (error) {
        throw toTRPCError(error);
      }
    }),

  /**
   * Create new <%= propertyName %>
   */
  create: publicProcedure
    .input(create<%= className %>Schema)
    .mutation(async ({ input, ctx }) => {
      const service = create<%= className %>Service(ctx.correlationId);
      try {
        return await service.create(input);
      } catch (error) {
        throw toTRPCError(error);
      }
    }),

  /**
   * Update <%= propertyName %>
   */
  update: publicProcedure
    .input(z.object({ id: z.string(), data: update<%= className %>Schema }))
    .mutation(async ({ input, ctx }) => {
      const service = create<%= className %>Service(ctx.correlationId);
      try {
        return await service.update(input.id, input.data);
      } catch (error) {
        throw toTRPCError(error);
      }
    }),

  /**
   * Delete <%= propertyName %>
   */
  delete: publicProcedure
    .input(z.string())
    .mutation(async ({ input, ctx }) => {
      const service = create<%= className %>Service(ctx.correlationId);
      try {
        await service.delete(input);
        return { success: true };
      } catch (error) {
        throw toTRPCError(error);
      }
    }),
});

/**
 * Service factory - Dependency injection
 */
function create<%= className %>Service(correlationId?: string): <%= className %>Service {
  const logger = new ConsoleLogger('<%= className %>Service', correlationId);
  const repository = new Prisma<%= className %>Repository(db, logger);
  const cache = new InMemoryCache();
  const eventBus = new InMemoryEventBus();

  return new <%= className %>Service({
    repository,
    logger,
    cache,
    eventBus,
  });
}

/**
 * Error mapper - Convert errors to tRPC errors
 */
function toTRPCError(error: unknown): TRPCError {
  if (error instanceof TRPCError) return error;

  if (error instanceof Error) {
    if (error.message.includes('not found')) {
      return new TRPCError({ code: 'NOT_FOUND', message: error.message });
    }
    return new TRPCError({ code: 'BAD_REQUEST', message: error.message });
  }

  return new TRPCError({ 
    code: 'INTERNAL_SERVER_ERROR', 
    message: 'An error occurred' 
  });
}
