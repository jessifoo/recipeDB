/**
 * MongoDB <%= className %> Repository
 * Generated by: nx g feature <%= fileName %> --adapter=mongo
 * 
 * Implements I<%= className %>Repository port for MongoDB
 */

import type { MongoClient, Collection } from 'mongodb';
import type { ILogger } from '@/core/ports/logger.port';
import type { <%= className %> } from '@/core/domain/<%= fileName %>.entity';
import type { 
  I<%= className %>Repository,
  Create<%= className %>DTO, 
  Update<%= className %>DTO, 
  <%= className %>Filter 
} from '@/core/ports/<%= fileName %>.repository.port';

interface <%= className %>Document {
  _id: string;
  <% fields.forEach(function(field) { %>
  <%= field.name %><% if (field.isOptional) { %>?<% } %>: <%= field.type %><% if (field.isArray) { %>[]<% } %>;
  <% }); %>
  createdAt: Date;
  updatedAt: Date;
}

export class Mongo<%= className %>Repository implements I<%= className %>Repository {
  private collection: Collection<<%= className %>Document>;

  constructor(
    private client: MongoClient,
    private logger: ILogger,
    private dbName: string = 'myapp'
  ) {
    this.collection = this.client.db(this.dbName).collection('<%= propertyName %>s');
  }

  async findById(id: string): Promise<<%= className %> | null> {
    try {
      const doc = await this.collection.findOne({ _id: id });
      return doc ? this.mapToEntity(doc) : null;
    } catch (error) {
      this.logger.error('MongoDB findById error', { error, id });
      throw new Error('Database error');
    }
  }

  async findMany(filter?: <%= className %>Filter): Promise<<%= className %>[]> {
    try {
      const query: any = {};

      if (filter?.search) {
        query.$or = [
          <% fields.filter(f => f.type === 'string' && !f.isArray).forEach(function(field, index) { %>
          { <%= field.name %>: { $regex: filter.search, $options: 'i' } },
          <% }); %>
        ];
      }

      const docs = await this.collection
        .find(query)
        .sort({ createdAt: -1 })
        .toArray();

      return docs.map(doc => this.mapToEntity(doc));
    } catch (error) {
      this.logger.error('MongoDB findMany error', { error });
      throw new Error('Database error');
    }
  }

  async create(data: Create<%= className %>DTO): Promise<<%= className %>> {
    try {
      const now = new Date();
      const doc: <%= className %>Document = {
        _id: this.generateId(),
        ...data,
        createdAt: now,
        updatedAt: now,
      };

      await this.collection.insertOne(doc);
      return this.mapToEntity(doc);
    } catch (error) {
      this.logger.error('MongoDB create error', { error });
      throw new Error('Database error');
    }
  }

  async update(id: string, data: Update<%= className %>DTO): Promise<<%= className %>> {
    try {
      const result = await this.collection.findOneAndUpdate(
        { _id: id },
        { 
          $set: { 
            ...data,
            updatedAt: new Date(),
          } 
        },
        { returnDocument: 'after' }
      );

      if (!result) {
        throw new Error('<%= className %> not found');
      }

      return this.mapToEntity(result);
    } catch (error) {
      this.logger.error('MongoDB update error', { error, id });
      throw new Error('Database error');
    }
  }

  async delete(id: string): Promise<void> {
    try {
      const result = await this.collection.deleteOne({ _id: id });
      
      if (result.deletedCount === 0) {
        throw new Error('<%= className %> not found');
      }
    } catch (error) {
      this.logger.error('MongoDB delete error', { error, id });
      throw new Error('Database error');
    }
  }

  async count(filter?: <%= className %>Filter): Promise<number> {
    try {
      const query: any = {};

      if (filter?.search) {
        query.$or = [
          <% fields.filter(f => f.type === 'string' && !f.isArray).forEach(function(field, index) { %>
          { <%= field.name %>: { $regex: filter.search, $options: 'i' } },
          <% }); %>
        ];
      }

      return await this.collection.countDocuments(query);
    } catch (error) {
      this.logger.error('MongoDB count error', { error });
      throw new Error('Database error');
    }
  }

  /**
   * Map MongoDB document to domain entity
   */
  private mapToEntity(doc: <%= className %>Document): <%= className %> {
    return {
      id: doc._id,
      <% fields.forEach(function(field) { %>
      <%= field.name %>: doc.<%= field.name %>,
      <% }); %>
      createdAt: doc.createdAt,
      updatedAt: doc.updatedAt,
    };
  }

  /**
   * Generate unique ID (MongoDB-style)
   */
  private generateId(): string {
    return `${Date.now().toString(36)}${Math.random().toString(36).substring(2)}`;
  }
}
