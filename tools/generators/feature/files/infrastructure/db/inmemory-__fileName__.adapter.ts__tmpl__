/**
 * In-Memory <%= className %> Repository
 * Generated by: nx g feature <%= fileName %> --adapter=inmemory
 * 
 * Implements I<%= className %>Repository port for testing
 */

import type { ILogger } from '@/core/ports/logger.port';
import type { <%= className %> } from '@/core/domain/<%= fileName %>.entity';
import type { 
  I<%= className %>Repository,
  Create<%= className %>DTO, 
  Update<%= className %>DTO, 
  <%= className %>Filter 
} from '@/core/ports/<%= fileName %>.repository.port';

export class InMemory<%= className %>Repository implements I<%= className %>Repository {
  private data = new Map<string, <%= className %>>();
  private idCounter = 0;

  constructor(private logger: ILogger) {}

  async findById(id: string): Promise<<%= className %> | null> {
    return this.data.get(id) || null;
  }

  async findMany(filter?: <%= className %>Filter): Promise<<%= className %>[]> {
    let results = Array.from(this.data.values());

    if (filter?.search) {
      const searchLower = filter.search.toLowerCase();
      results = results.filter(<%= propertyName %> => {
        <% fields.filter(f => f.type === 'string' && !f.isArray).forEach(function(field, index) { %>
        <% if (index === 0) { %>return <% } else { %>|| <% } %><%= propertyName %>.<%= field.name %><% if (field.isOptional) { %>?<% } %>.toLowerCase().includes(searchLower)
        <% }); %>;
      });
    }

    return results.sort((a, b) => b.createdAt.getTime() - a.createdAt.getTime());
  }

  async create(data: Create<%= className %>DTO): Promise<<%= className %>> {
    const now = new Date();
    const <%= propertyName %>: <%= className %> = {
      id: `<%= propertyName %>-${++this.idCounter}`,
      ...data,
      createdAt: now,
      updatedAt: now,
    };
    this.data.set(<%= propertyName %>.id, <%= propertyName %>);
    return <%= propertyName %>;
  }

  async update(id: string, data: Update<%= className %>DTO): Promise<<%= className %>> {
    const existing = this.data.get(id);
    if (!existing) {
      throw new Error('<%= className %> not found');
    }

    const updated: <%= className %> = {
      ...existing,
      ...data,
      updatedAt: new Date(),
    };

    this.data.set(id, updated);
    return updated;
  }

  async delete(id: string): Promise<void> {
    if (!this.data.has(id)) {
      throw new Error('<%= className %> not found');
    }
    this.data.delete(id);
  }

  async count(filter?: <%= className %>Filter): Promise<number> {
    const results = await this.findMany(filter);
    return results.length;
  }

  /**
   * Test helper - Clear all data
   */
  clear(): void {
    this.data.clear();
    this.idCounter = 0;
  }

  /**
   * Test helper - Seed data
   */
  seed(<%= propertyName %>s: <%= className %>[]): void {
    <%= propertyName %>s.forEach(<%= propertyName %> => {
      this.data.set(<%= propertyName %>.id, <%= propertyName %>);
    });
  }
}
