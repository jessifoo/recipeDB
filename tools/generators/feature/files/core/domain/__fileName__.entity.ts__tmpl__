/**
 * <%= className %> Entity - Pure domain model
 * Generated by: nx g feature <%= fileName %>
 */

export interface <%= className %> {
  id: string;
  <% fields.forEach(function(field) { %>
  <%= field.name %>: <%= field.type %><% if (field.isArray) { %>[]<% } %><% if (field.isOptional) { %> | undefined<% } %>;
  <% }); %>
  createdAt: Date;
  updatedAt: Date;
}

/**
 * Domain rules and business invariants
 */
export class <%= className %>Rules {
  <% fields.filter(f => f.type === 'string').forEach(function(field) { %>
  static readonly MIN_<%= field.name.toUpperCase() %>_LENGTH = 1;
  static readonly MAX_<%= field.name.toUpperCase() %>_LENGTH = 255;

  static validate<%= field.name.charAt(0).toUpperCase() + field.name.slice(1) %>(<%= field.name %>: string): void {
    if (<%= field.name %>.length < this.MIN_<%= field.name.toUpperCase() %>_LENGTH || 
        <%= field.name %>.length > this.MAX_<%= field.name.toUpperCase() %>_LENGTH) {
      throw new Error(
        `<%= field.name %> must be between ${this.MIN_<%= field.name.toUpperCase() %>_LENGTH} and ${this.MAX_<%= field.name.toUpperCase() %>_LENGTH} characters`
      );
    }
  }
  <% }); %>

  /**
   * Add your business rules here
   * @example
   * static cannotBeDeletedIfActive(entity: <%= className %>): void {
   *   if (entity.active) {
   *     throw new Error('Cannot delete active <%= propertyName %>');
   *   }
   * }
   */
}
