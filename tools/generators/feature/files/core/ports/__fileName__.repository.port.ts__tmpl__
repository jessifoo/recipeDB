/**
 * <%= className %> Repository Port - Database abstraction
 * Generated by: nx g feature <%= fileName %>
 * 
 * ANY database can implement this interface:
 * - Prisma (PostgreSQL, MySQL, SQLite)
 * - MongoDB
 * - DynamoDB
 * - Supabase
 * - In-Memory (for testing)
 */

import type { <%= className %> } from '../domain/<%= fileName %>.entity';

/**
 * Create DTO - Data required to create <%= propertyName %>
 */
export interface Create<%= className %>DTO {
  <% fields.forEach(function(field) { %>
  <%= field.name %><% if (field.isOptional) { %>?<% } %>: <%= field.type %><% if (field.isArray) { %>[]<% } %>;
  <% }); %>
}

/**
 * Update DTO - Partial update of <%= propertyName %>
 */
export interface Update<%= className %>DTO {
  <% fields.forEach(function(field) { %>
  <%= field.name %>?: <%= field.type %><% if (field.isArray) { %>[]<% } %>;
  <% }); %>
}

/**
 * Filter - Query filters for <%= propertyName %>
 */
export interface <%= className %>Filter {
  search?: string;
  // Add custom filters here based on your domain
  // Example: status?: 'active' | 'inactive';
  // Example: createdAfter?: Date;
}

/**
 * Repository Interface - Implement in infrastructure layer
 * 
 * @example Prisma
 * class Prisma<%= className %>Repository implements I<%= className %>Repository { ... }
 * 
 * @example MongoDB
 * class Mongo<%= className %>Repository implements I<%= className %>Repository { ... }
 */
export interface I<%= className %>Repository {
  /**
   * Find by ID
   * @returns <%= className %> or null if not found
   */
  findById(id: string): Promise<<%= className %> | null>;

  /**
   * Find many with optional filter
   * @returns Array of <%= propertyName %>s
   */
  findMany(filter?: <%= className %>Filter): Promise<<%= className %>[]>;

  /**
   * Create new <%= propertyName %>
   * @returns Created <%= propertyName %>
   */
  create(data: Create<%= className %>DTO): Promise<<%= className %>>;

  /**
   * Update existing <%= propertyName %>
   * @returns Updated <%= propertyName %>
   * @throws If not found
   */
  update(id: string, data: Update<%= className %>DTO): Promise<<%= className %>>;

  /**
   * Delete <%= propertyName %>
   * @throws If not found
   */
  delete(id: string): Promise<void>;

  /**
   * Count <%= propertyName %>s with optional filter
   */
  count(filter?: <%= className %>Filter): Promise<number>;
}
