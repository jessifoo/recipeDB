/**
 * <%= className %> Service - Business logic layer
 * Generated by: nx g feature <%= fileName %>
 * 
 * Framework-agnostic, fully testable with mocked dependencies
 */

import type { <%= className %> } from '../domain/<%= fileName %>.entity';
import { <%= className %>Rules } from '../domain/<%= fileName %>.entity';
import type { IRepository } from '../ports/repository.port';
import type { ILogger } from '../ports/logger.port';
import type { ICache } from '../ports/cache.port';
import type { IEventBus } from '../ports/event-bus.port';
import { CacheKeyBuilder } from '../ports/cache.port';

/**
 * DTOs - Data Transfer Objects
 */
export interface Create<%= className %>DTO {
  <% fields.forEach(function(field) { %>
  <%= field.name %><% if (field.isOptional) { %>?<% } %>: <%= field.type %><% if (field.isArray) { %>[]<% } %>;
  <% }); %>
}

export interface Update<%= className %>DTO {
  <% fields.forEach(function(field) { %>
  <%= field.name %>?: <%= field.type %><% if (field.isArray) { %>[]<% } %>;
  <% }); %>
}

export interface <%= className %>Filter {
  search?: string;
  // Add filter fields as needed
}

/**
 * Service dependencies - Injected via constructor
 */
export interface <%= className %>ServiceDeps {
  repository: IRepository<<%= className %>, Create<%= className %>DTO, Update<%= className %>DTO>;
  logger: ILogger;
  cache?: ICache;
  eventBus?: IEventBus;
}

/**
 * <%= className %> Service - Framework agnostic
 */
export class <%= className %>Service {
  constructor(private deps: <%= className %>ServiceDeps) {}

  async getById(id: string): Promise<<%= className %>> {
    this.deps.logger.info('Getting <%= propertyName %> by ID', { id });

    // Try cache first
    if (this.deps.cache) {
      const cached = await this.deps.cache.get<<%= className %>>(
        CacheKeyBuilder.example(id) // TODO: Update cache key
      );
      if (cached) {
        this.deps.logger.debug('Cache hit', { id });
        return cached;
      }
    }

    const <%= propertyName %> = await this.deps.repository.findById(id);
    if (!<%= propertyName %>) {
      throw new Error('<%= className %> not found');
    }

    // Cache for future requests
    if (this.deps.cache) {
      await this.deps.cache.set(
        CacheKeyBuilder.example(id), // TODO: Update cache key
        <%= propertyName %>,
        300 // 5 min TTL
      );
    }

    return <%= propertyName %>;
  }

  async list(filter?: <%= className %>Filter): Promise<<%= className %>[]> {
    this.deps.logger.info('Listing <%= propertyName %>s', { filter });
    return this.deps.repository.findMany(filter);
  }

  async create(data: Create<%= className %>DTO): Promise<<%= className %>> {
    this.deps.logger.info('Creating <%= propertyName %>', { data });

    // Validate business rules
    <% fields.filter(f => f.type === 'string' && !f.isOptional).forEach(function(field) { %>
    <%= className %>Rules.validate<%= field.name.charAt(0).toUpperCase() + field.name.slice(1) %>(data.<%= field.name %>);
    <% }); %>

    // TODO: Add your business logic here
    // Example: Check for duplicates, validate relationships, etc.

    const <%= propertyName %> = await this.deps.repository.create(data);
    this.deps.logger.info('<%= className %> created successfully', { id: <%= propertyName %>.id });

    // Invalidate cache
    if (this.deps.cache) {
      await this.deps.cache.delete(CacheKeyBuilder.exampleList()); // TODO: Update cache key
    }

    // Publish event
    if (this.deps.eventBus) {
      await this.deps.eventBus.publish({
        eventId: `${<%= propertyName %>.id}-created`,
        eventType: '<%= propertyName %>.created',
        occurredAt: new Date(),
        payload: { id: <%= propertyName %>.id },
      });
    }

    return <%= propertyName %>;
  }

  async update(id: string, data: Update<%= className %>DTO): Promise<<%= className %>> {
    this.deps.logger.info('Updating <%= propertyName %>', { id });

    // Business rule: Must provide at least one field
    if (Object.keys(data).length === 0) {
      throw new Error('Must provide at least one field to update');
    }

    // Validate if provided
    <% fields.filter(f => f.type === 'string').forEach(function(field) { %>
    if (data.<%= field.name %>) {
      <%= className %>Rules.validate<%= field.name.charAt(0).toUpperCase() + field.name.slice(1) %>(data.<%= field.name %>);
    }
    <% }); %>

    // TODO: Add your update business logic here

    const <%= propertyName %> = await this.deps.repository.update(id, data);

    // Invalidate cache
    if (this.deps.cache) {
      await this.deps.cache.delete(CacheKeyBuilder.example(id)); // TODO: Update cache key
      await this.deps.cache.delete(CacheKeyBuilder.exampleList()); // TODO: Update cache key
    }

    return <%= propertyName %>;
  }

  async delete(id: string): Promise<void> {
    this.deps.logger.info('Deleting <%= propertyName %>', { id });

    // TODO: Add delete business logic here
    // Example: Check if can be deleted, cascade deletes, etc.

    await this.deps.repository.delete(id);
    this.deps.logger.info('<%= className %> deleted successfully', { id });

    // Invalidate cache
    if (this.deps.cache) {
      await this.deps.cache.delete(CacheKeyBuilder.example(id)); // TODO: Update cache key
      await this.deps.cache.delete(CacheKeyBuilder.exampleList()); // TODO: Update cache key
    }

    // Publish event
    if (this.deps.eventBus) {
      await this.deps.eventBus.publish({
        eventId: `${id}-deleted`,
        eventType: '<%= propertyName %>.deleted',
        occurredAt: new Date(),
        payload: { id },
      });
    }
  }
}
