/**
 * <%= className %> Service Tests - Unit tests with mocked dependencies
 * Generated by: nx g feature <%= fileName %>
 */

import { describe, it, expect, vi, beforeEach } from 'vitest';
import { <%= className %>Service } from './<%= fileName %>.service';
import type { <%= className %> } from '../domain/<%= fileName %>.entity';
import type { IRepository } from '../ports/repository.port';
import type { ILogger } from '../ports/logger.port';
import type { ICache } from '../ports/cache.port';
import type { IEventBus } from '../ports/event-bus.port';

describe('<%= className %>Service - Unit Tests', () => {
  let mockRepository: IRepository<<%= className %>, any, any>;
  let mockLogger: ILogger;
  let mockCache: ICache;
  let mockEventBus: IEventBus;
  let service: <%= className %>Service;

  beforeEach(() => {
    mockRepository = {
      findById: vi.fn(),
      findMany: vi.fn(),
      create: vi.fn(),
      update: vi.fn(),
      delete: vi.fn(),
    };

    mockLogger = {
      info: vi.fn(),
      error: vi.fn(),
      warn: vi.fn(),
      debug: vi.fn(),
    };

    mockCache = {
      get: vi.fn(),
      set: vi.fn(),
      delete: vi.fn(),
      clear: vi.fn(),
    };

    mockEventBus = {
      publish: vi.fn(),
      subscribe: vi.fn(),
    };

    service = new <%= className %>Service({
      repository: mockRepository,
      logger: mockLogger,
      cache: mockCache,
      eventBus: mockEventBus,
    });
  });

  describe('getById', () => {
    it('should return <%= propertyName %> from cache if available', async () => {
      const cached<%= className %>: <%= className %> = {
        id: '1',
        <% fields.forEach(function(field) { %>
        <%= field.name %>: <% if (field.type === 'string') { %>'test-<%= field.name %>'<% } else if (field.type === 'number') { %>123<% } else if (field.type === 'boolean') { %>true<% } else if (field.isArray) { %>[]<% } else { %>new Date()<% } %>,
        <% }); %>
        createdAt: new Date(),
        updatedAt: new Date(),
      };

      vi.mocked(mockCache.get).mockResolvedValue(cached<%= className %>);

      const result = await service.getById('1');

      expect(result).toEqual(cached<%= className %>);
      expect(mockRepository.findById).not.toHaveBeenCalled();
    });

    it('should throw if <%= propertyName %> not found', async () => {
      vi.mocked(mockCache.get).mockResolvedValue(null);
      vi.mocked(mockRepository.findById).mockResolvedValue(null);

      await expect(service.getById('999')).rejects.toThrow('<%= className %> not found');
    });
  });

  describe('create', () => {
    it('should create <%= propertyName %> and publish event', async () => {
      const created: <%= className %> = {
        id: '1',
        <% fields.forEach(function(field) { %>
        <%= field.name %>: <% if (field.type === 'string') { %>'test-<%= field.name %>'<% } else if (field.type === 'number') { %>123<% } else if (field.type === 'boolean') { %>true<% } else if (field.isArray) { %>[]<% } else { %>new Date()<% } %>,
        <% }); %>
        createdAt: new Date(),
        updatedAt: new Date(),
      };

      vi.mocked(mockRepository.create).mockResolvedValue(created);

      const result = await service.create({
        <% fields.forEach(function(field) { %>
        <%= field.name %>: <% if (field.type === 'string') { %>'test-<%= field.name %>'<% } else if (field.type === 'number') { %>123<% } else if (field.type === 'boolean') { %>true<% } else if (field.isArray) { %>[]<% } else { %>new Date()<% } %>,
        <% }); %>
      });

      expect(result).toEqual(created);
      expect(mockEventBus.publish).toHaveBeenCalledWith(
        expect.objectContaining({
          eventType: '<%= propertyName %>.created',
          payload: { id: '1' },
        })
      );
    });
  });

  // TODO: Add more tests for update, delete, list, etc.
});
