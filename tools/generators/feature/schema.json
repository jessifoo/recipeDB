{
  "$schema": "http://json-schema.org/schema",
  "id": "feature-generator",
  "title": "Generate a complete feature",
  "description": "Creates domain entity, service, repository, adapter, router, and tests",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Feature name (e.g., 'recipe', 'product', 'user')",
      "$default": {
        "$source": "argv",
        "index": 0
      },
      "x-prompt": "What is the feature name?"
    },
    "fields": {
      "type": "string",
      "description": "Comma-separated fields with types (e.g., 'title:string,price:number,active:boolean')",
      "x-prompt": "What fields does this entity have? (format: name:type,name:type)"
    },
    "skipTests": {
      "type": "boolean",
      "description": "Skip generating test files",
      "default": false
    }
  },
  "required": ["name", "fields"]
}
