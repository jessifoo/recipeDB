{
  "$schema": "http://json-schema.org/schema",
  "id": "feature-generator",
  "title": "Generate a complete feature",
  "description": "Creates domain entity, service, repository, adapter, router, and tests",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Feature name (e.g., 'recipe', 'product', 'user')",
      "$default": {
        "$source": "argv",
        "index": 0
      },
      "x-prompt": "What is the feature name?"
    },
    "fields": {
      "type": "string",
      "description": "Comma-separated fields with types (e.g., 'title:string,price:number,active:boolean')",
      "x-prompt": "What fields does this entity have? (format: name:type,name:type)"
    },
    "adapter": {
      "type": "string",
      "description": "Database adapter to generate (prisma, mongo, inmemory, all)",
      "enum": ["prisma", "mongo", "inmemory", "all"],
      "default": "prisma",
      "x-prompt": {
        "message": "Which database adapter?",
        "type": "list",
        "items": [
          { "value": "prisma", "label": "Prisma (PostgreSQL)" },
          { "value": "mongo", "label": "MongoDB" },
          { "value": "inmemory", "label": "In-Memory (testing)" },
          { "value": "all", "label": "All adapters" }
        ]
      }
    },
    "skipTests": {
      "type": "boolean",
      "description": "Skip generating test files",
      "default": false
    }
  },
  "required": ["name", "fields"]
}
