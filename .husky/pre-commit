#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running pre-commit validation..."
echo ""

# 0. CRITICAL: No package.json in packages/
echo "0/8 Checking for rogue package.json files..."
node tools/validators/no-package-json-validator.js || exit 1

# 1. File marker validation
echo "1/8 Checking file markers..."
node tools/validators/file-marker-validator.js || exit 1

# 2. Duplicate detection
echo "2/8 Checking for duplicates..."
node tools/validators/duplicate-detector.js || exit 1

# 3. Package validation
echo "3/8 Validating packages..."
node tools/validators/package-lock-validator.js || exit 1

# 4. Directory structure
echo "4/8 Validating directory structure..."
node tools/validators/directory-structure-validator.js || exit 1

# 5. Import validation
echo "5/8 Validating imports..."
node tools/validators/import-validator.js || exit 1

# 6. Biome check
echo "6/8 Running Biome..."
npx biome check --apply . || exit 1

# 7. TypeScript compilation
echo "7/8 Type checking..."
npx tsc --noEmit || exit 1

# 8. Test related files
echo "8/8 Running tests..."
npm test -- --bail --findRelatedTests || exit 1

echo ""
echo "✅ All pre-commit checks passed!"
