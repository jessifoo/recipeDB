#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running pre-commit validation..."
echo ""

# 0. CRITICAL: No package.json in packages/
echo " 0/12 Checking for rogue package.json files..."
node tools/validators/no-package-json-validator.js || exit 1

# 1. Code quality (no TODOs, no .only, no empty catch)
echo " 1/12 Checking code quality..."
node tools/validators/code-quality-validator.js || exit 1

# 2. Type coverage (no explicit 'any')
echo " 2/12 Checking type coverage..."
node tools/validators/type-coverage-validator.js || exit 1

# 3. File marker validation
echo " 3/12 Checking file markers..."
node tools/validators/file-marker-validator.js || exit 1

# 4. Duplicate detection
echo " 4/12 Checking for duplicates..."
node tools/validators/duplicate-detector.js || exit 1

# 5. Package validation
echo " 5/12 Validating packages..."
node tools/validators/package-lock-validator.js || exit 1

# 6. Directory structure
echo " 6/12 Validating directory structure..."
node tools/validators/directory-structure-validator.js || exit 1

# 7. Import validation
echo " 7/12 Validating imports..."
node tools/validators/import-validator.js || exit 1

# 8. Complexity check (warnings only)
echo " 8/12 Checking function complexity..."
node tools/validators/function-complexity-validator.js || true

# 9. Test coverage (warnings only for now)
echo " 9/12 Checking test coverage..."
node tools/validators/test-coverage-validator.js || true

# 10. Biome check
echo "10/12 Running Biome..."
npx biome check --apply . || exit 1

# 11. TypeScript compilation
echo "11/12 Type checking..."
npx tsc --noEmit || exit 1

# 12. Test related files
echo "12/12 Running tests..."
npm test -- --bail --findRelatedTests || exit 1

echo ""
echo "✅ All pre-commit checks passed!"
