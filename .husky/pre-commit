#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running pre-commit validation..."
echo ""

# 1. Enforce centralized patterns (MOST IMPORTANT)
echo "1/5 Enforcing centralized patterns..."
node tools/validators/enforce-centralized.js || exit 1

# 2. Code quality
echo "2/5 Checking code quality..."
node tools/validators/code-quality-validator.js || exit 1

# 3. Biome check
echo "3/5 Running Biome..."
npx biome check --apply . || exit 1

# 4. TypeScript compilation
echo "4/5 Type checking..."
npx tsc --noEmit || exit 1

# 5. Tests
echo "5/5 Running tests..."
npm test -- --bail || exit 1

echo ""
echo "✅ All checks passed!"
