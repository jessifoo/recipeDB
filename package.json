{
  "name": "@app/template",
  "version": "1.0.0",
  "description": "AI-proof TypeScript template with maximum enforcement",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "npx nx run web:dev",
    "build": "npx nx run-many --target=build",
    "lint": "npx biome check .",
    "lint:fix": "npx biome check --apply .",
    "typecheck": "tsc --noEmit",
    "type-coverage": "npx type-coverage",
    "test": "npx nx run-many --target=test",
    "test:coverage": "npx vitest run --coverage",
    "validate": "npm run lint && npm run typecheck && npm run type-coverage && npm run test",
    "quality": "node tools/validators/code-quality-validator.js && node tools/validators/type-coverage-validator.js && node tools/validators/function-complexity-validator.js",
    "prepare": "husky install",
    "db:migrate": "npx prisma migrate dev",
    "db:generate": "npx prisma generate",
    "db:studio": "npx prisma studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.5.0",
    "@nx/devkit": "^18.0.0",
    "@nx/jest": "^18.0.0",
    "@nx/js": "^18.0.0",
    "@nx/next": "^18.0.0",
    "@nx/playwright": "^18.0.0",
    "@nx/react": "^18.0.0",
    "@playwright/test": "^1.40.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "husky": "^8.0.0",
    "nx": "^18.0.0",
    "prisma": "^5.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "glob": "^10.0.0",
    "minimatch": "^9.0.0",
    "type-coverage": "^2.27.0"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "next": "^15.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.22.0",
    "@t3-oss/env-nextjs": "^0.9.0",
    "@trpc/server": "^11.0.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/next": "^11.0.0",
    "@tanstack/react-query": "^5.0.0",
    "next-auth": "^5.0.0-beta",
    "@auth/prisma-adapter": "^1.0.0",
    "zustand": "^4.0.0",
    "react-hook-form": "^7.0.0",
    "@hookform/resolvers": "^3.0.0",
    "superjson": "^2.0.0",
    "nuqs": "^1.0.0"
  },
  "author": "Jessica Johnson <2334167+jessifoo@users.noreply.github.com>",
  "packageManager": "pnpm@10.4.0",
  "engines": {
    "node": ">=18.0.0"
  }
}

