{
  "name": "@app/template",
  "version": "1.0.0",
  "description": "AI-proof TypeScript template with maximum enforcement",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "npx nx run web:dev",
    "build": "npx nx run-many --target=build",
    "lint": "npx biome check .",
    "lint:fix": "npx biome check --apply .",
    "typecheck": "tsc --noEmit",
    "type-coverage": "npx type-coverage",
    "test": "npx nx run-many --target=test",
    "test:coverage": "npx vitest run --coverage",
    "validate": "npm run lint && npm run typecheck && npm run type-coverage && npm run test",
    "quality": "node tools/validators/code-quality-validator.js && node tools/validators/type-coverage-validator.js && node tools/validators/function-complexity-validator.js",
    "prepare": "husky install",
    "db:migrate": "npx prisma migrate dev",
    "db:generate": "npx prisma generate",
    "db:studio": "npx prisma studio",
    "generate:feature": "nx g feature"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@nx/devkit": "^20.2.3",
    "@nx/jest": "^20.2.3",
    "@nx/js": "^20.2.3",
    "@nx/next": "^20.2.3",
    "@nx/playwright": "^20.2.3",
    "@nx/react": "^20.2.3",
    "@playwright/test": "^1.49.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "husky": "^9.1.7",
    "nx": "^20.2.3",
    "prisma": "^6.1.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@vitest/coverage-v8": "^2.1.8",
    "glob": "^11.0.0",
    "minimatch": "^10.0.1",
    "type-coverage": "^2.30.1",
    "tsx": "^4.19.2"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "next": "^15.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1",
    "@t3-oss/env-nextjs": "^0.11.1",
    "@trpc/server": "^11.0.0-rc.650",
    "@trpc/client": "^11.0.0-rc.650",
    "@trpc/react-query": "^11.0.0-rc.650",
    "@trpc/next": "^11.0.0-rc.650",
    "@tanstack/react-query": "^5.62.12",
    "next-auth": "5.0.0-beta.25",
    "@auth/prisma-adapter": "^2.7.4",
    "zustand": "^5.0.2",
    "react-hook-form": "^7.54.1",
    "@hookform/resolvers": "^3.9.1",
    "superjson": "^2.2.2",
    "nuqs": "^2.2.4"
  },
  "author": "Jessica Johnson <2334167+jessifoo@users.noreply.github.com>",
  "packageManager": "pnpm@10.4.0",
  "engines": {
    "node": ">=18.0.0"
  }
}

